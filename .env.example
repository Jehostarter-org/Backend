# Django
SECRET_KEY=your-django-secret-key
DEBUG=False
ALLOWED_HOSTS=api.jehostarter.com,localhost,127.0.0.1

# Database (PostGIS)
DATABASE_URL=postgresql://postgres:your-password@db:5432/jehostarter
DB_NAME=jehostarter
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://jehostarter.com
CSRF_TRUSTED_ORIGINS=https://jehostarter.com

# Frontend & Backend URLs
FRONTEND_URL=https://jehostarter.com
BACKEND_URL=https://api.jehostarter.com

# Admin Registration
ADMIN_REGISTRATION_SECRET=your-random-admin-secret

# Email (Gmail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Jehostarter <your-email@gmail.com>

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# External APIs
ORS_API_KEY=your-openrouteservice-api-key
GRAPH_HOPPER_API_KEY=your-graphhopper-api-key
