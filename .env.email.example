# Copy these lines into backend/.env to send real verification emails via SMTP.
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Jehostarter <your.email@gmail.com>
FRONTEND_URL=http://localhost:3000
